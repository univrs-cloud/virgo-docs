---
import Head from '@astrojs/starlight/components/Head.astro';
---

<Head><slot /></Head>

{Astro.locals.starlightRoute.id === '404' && <meta name="plausible-404" content="true" />}

<script>
	import { init, track } from '@plausible-analytics/tracker';

	init({
		domain: 'docs.univrs.cloud',
		endpoint: 'https://analytics.univrs.cloud/api/event',
		autoCapturePageviews: true,
		outboundLinks: true,
		fileDownloads: true,
		formSubmissions: true,
		hashBasedRouting: true,
		captureOnLocalhost: false
	});

	if (document.querySelector('meta[name="plausible-404"]')) {
		track('404', { props: { path: window.location.pathname } });
	}
</script>
